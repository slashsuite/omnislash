{
  "name": "ob-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --host --strictPort --port ${PORT:?set PORT from ob ports next}",
    "build": "bun --bun vite build",
    "serve": "bun serve.ts",
    "storybook": "storybook dev -p ${PORT:?set PORT from ob ports next} -h 0.0.0.0 --exact-port --no-open",
    "build-storybook": "storybook build",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test ./src && bun --bun vitest run"
  },
  "dependencies": {
    "@slashsuite/themes": "^0.5.0",
    "@slashsuite/ui-react": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "qrcode": "^1.5.4",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "^1.132.0",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "seroval": "^1.8.1",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "ob-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --host --strictPort --port ${PORT:?set PORT from ob ports next}",
    "build": "bun --bun vite build",
    "serve": "bun serve.ts",
    "storybook": "storybook dev -p ${PORT:?set PORT from ob ports next} -h 0.0.0.0 --exact-port --no-open",
    "build-storybook": "storybook build",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test ./src && bun --bun vitest run"
  },
  "dependencies": {
    "@slashsuite/themes": "^0.5.0",
    "@slashsuite/ui-react": "^0.13.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "seroval": "^1.8.1",
    "storybook": "10.6.7",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

// ob models file (OB-1969): this machine's LOCAL OVERRIDE. Copy to ~/.config/ob/models.jsonc with `ob models init`.
// Since OS-145 the shared setting is the server's `model_routes` (`ob models set|use|reader` write it); anything
// this file names wins over it on this machine only, and its "active" wins over the server's here.
// `ob models show` prints every route with where it came from (local, server or default).
// Model values use the <provider>:<model> form for builders: the provider is a T3 provider
// instance id, a bare id runs on the T3 project's own provider. Model ids only: no secret here.
{
  "active": "claude",
  // Profiles tried in order when an account is out of credits (OB-1970): the active one first,
  // then this list. A spinoff launch and a review leg each move to the next one on a credit or
  // quota error only, never on any other error.
  "fallback": ["claude"],
  "profiles": {
    "claude": {
      // The blind scorer in the planner's measure-twice step.
      "checker": "claude-haiku-5-5",
      // Any route, as a fallback chain with an optional effort (OS-145). Routes: builder.<from>-<to>,
      // checker, role.architect|sentinel|muse, sweep.first, sweep.escalate, subagent.explore, subagent.fixup,
      // job.<name>. An entry here beats the same route in "checker" above.
      "routes": {
        // Which model a spinoff builder runs on, by `ob spinoff --complexity <1-10>` (OS-177). The ranges must
        // cover 1-10 with no gap and no overlap. 1-3 runs DeepSeek on opencode, and the planner dispatches
        // it with `--effort high` (OB-1991). An older file's "builder": {"simple"|"medium"|"complex": ...}
        // still loads, as 1-3, 4-6 and 7-10, but one profile cannot mix the two forms.
        "builder.1-3": { "chain": ["opencode:opencode-go/deepseek-v4.1-flash"] },
        "builder.4-6": { "chain": ["claudeAgent:claude-sonnet-5-5"] },
        "builder.7-10": { "chain": ["claudeAgent:claude-opus-5-5"] }
        // ,"role.architect": { "chain": ["claudeAgent:claude-opus-5-5"], "effort": "high" }
      },
      // The skeptical-review legs. An antigravity: id runs through agy, an opencode/ or opencode-go/ id
      // runs through opencode, anything else through claude, so a profile may move a leg between
      // providers. The default legs when review_readers is unset are `neon` and `opus`; `deepseek` and
      // `luna` are retired (OS-206) and a profile naming either is refused. `opus` runs at its default effort; an older file's `sonnet`
      // key is read as `opus` (OB-2107).
      "review": {
        "neon": "antigravity:gemini-4-neon",
        "opus": "claude-opus-5-5"
      }
    }
    // A second account: add a profile, then `ob models use claude2`. The provider before the colon is the
    // id of a second Claude provider instance added in T3 Code (Settings, Providers), not a credential.
    // ,"claude2": {
    //   "routes": {
    //     "builder.1-3": { "chain": ["claudeAgent2:claude-haiku-5-5"] },
    //     "builder.4-6": { "chain": ["claudeAgent2:claude-sonnet-5-5"] },
    //     "builder.7-10": { "chain": ["claudeAgent2:claude-opus-5-5"] }
    //   },
    //   "checker": "claude-haiku-5-5",
    //   "review": { "opus": "claude-opus-5-5" }
    // }
  }
}

{
  "name": "omnislash",
  "version": "1.0.0",
  "description": "Personal task tracker CLI (ob) \u2014 unified, prioritized worklist across side projects, home, admin, and learning.",
  "type": "module",
  "bin": {
    "ob": "src/index.ts"
  },
  "scripts": {
    "ob": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/index.ts --outfile out/ob"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5"
  },
  "dependencies": {
    "@omnislash/state-machine": "workspace:*",
    "@sentry/bun": "11.13.0",
    "drizzle-orm": "^0.45.4"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "17.10.0-beta.17",
    "@embedded-postgres/darwin-x64": "17.10.0-beta.17",
    "@embedded-postgres/linux-arm64": "17.10.0-beta.17",
    "@embedded-postgres/linux-x64": "17.10.0-beta.17"
  }
}

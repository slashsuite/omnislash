#!/usr/bin/env python3
"""pr-wait: watch one GitHub pull request and print one line per real event.

  pr-wait <pr> [--repo owner/name] [--until ready|green|any-change] [--gate gate] [--interval 20]

Adapted from t3dotgg/tstack (babysit-pr/scripts/pr-wait) for OmniSlash. OmniSlash runs no review bots, so the
signals are the checks on the PR head (the `gate` check, from .github/workflows/ci.yml; --gate renames it, and a
repo with no check of that name needs every other check passed and at least one) plus the merge state. Greptile, Macroscope and CodeRabbit are not read.

--until
  green       the gate check and every other check on the current head passed (PixelSlash aside, below)
  ready       green and the PR mergeable (default)
  any-change  stop on the first event

PixelSlash is a review, not CI (OB-2544; the rule is skills/ob-babysit-pr/SKILL.md, "PixelSlash is a review,
not CI"). A status whose name is PixelSlash, or starts with it, waits on a human, so a pending one is never
waited on and never a failure: green and ready print `PixelSlash review owed: <status> <link>` for each one
still pending, before the final line. A failed or errored PixelSlash status is a broken upload and exits 1.

Exit codes
  0  the --until condition is met, or the PR merged
  1  it needs action: a check failed, the branch conflicts (DIRTY) or is BEHIND, or the PR closed
  2  bad arguments, unknown PR, or another pr-wait already watches this PR

Events, one line each on stdout: gate failed or passed; merged or closed; DIRTY or BEHIND; a comment,
review or inline review comment from someone other than the PR author or the gh user. Bot logins and
edits are not events. State lives in ~/.local/state/pr-wait/: a restarted watcher reports what arrived
since it last ran, and the first run records what already exists and reports nothing.

On start, an open PR whose head branch is a building spinoff row moves that row to phase pr_ci
(`ob spinoff phase <id> pr_ci`, OS-285); a handed-off or landed row is left alone.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import subprocess
import sys
import time
from pathlib import Path

STATE_DIR = Path.home() / ".local" / "state" / "pr-wait"
MERGEABLE = {"CLEAN", "HAS_HOOKS", "UNSTABLE"}
FAILED = {"fail", "cancel"}
PASSED = {"pass", "skipping"}
MAX_FAILED_POLLS = 10


class GhError(Exception):
    pass


def fail(message: str, code: int = 2) -> None:
    # Fatal messages go to stdout so a monitor shows the agent why the watcher stopped.
    print(f"pr-wait: {message}", flush=True)
    sys.exit(code)


def gh(args: list[str], ok: tuple[int, ...] = (0,)) -> str:
    proc = subprocess.run(["gh", *args], capture_output=True, text=True)
    if proc.returncode not in ok:
        lines = proc.stderr.strip().splitlines()
        raise GhError(lines[-1] if lines else f"gh exited {proc.returncode}")
    return proc.stdout


def snippet(text: str, limit: int = 100) -> str:
    flat = " ".join((text or "").split())
    return flat if len(flat) <= limit else flat[: limit - 3] + "..."


def is_pixelslash(name: str) -> bool:
    """A PixelSlash visual status: named PixelSlash, or starting with it (`PixelSlash / hackcove-ui-actions`)."""
    head = (name or "").strip().lower()
    return head == "pixelslash" or (head.startswith("pixelslash") and not (head[10].isalnum() or head[10] == "_"))


def owed_line(row: dict) -> str:
    desc = " ".join((row.get("description") or "").split())
    return "PixelSlash review owed: " + " ".join(p for p in (row["name"], f"({desc})" if desc else "", row.get("link") or "") if p)


def parse_target(raw: str | None, repo: str | None) -> tuple[str, int]:
    if not raw:
        fail("missing PR number. Usage: pr-wait <pr> [--repo owner/name]")
    if raw.startswith("https://github.com/"):
        parts = raw.split("?")[0].split("#")[0].rstrip("/").split("/")
        if len(parts) != 8 or parts[6] != "pull" or not parts[7].isdigit():
            fail(f"'{raw}' is not a GitHub PR URL")
        repo = repo or f"{parts[3]}/{parts[4]}"
        pr = int(parts[7])
    elif raw.lstrip("#").isdigit():
        pr = int(raw.lstrip("#"))
    else:
        fail(f"'{raw}' is not a PR number or PR URL")
    if not repo:
        try:
            repo = gh(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).strip()
        except GhError as error:
            fail(f"no --repo given and the current directory has no GitHub repo ({error})")
    try:
        gh(["pr", "view", str(pr), "-R", repo, "--json", "number"])
    except GhError as error:
        fail(f"cannot read {repo}#{pr}: {error}")
    return repo, pr


def ob(args: list[str]) -> subprocess.CompletedProcess | None:
    """Run `ob` (PR_WAIT_OB overrides the command, for tests). None when it cannot be run at all."""
    try:
        return subprocess.run([os.environ.get("PR_WAIT_OB") or "ob", *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None


def mark_pr_ci(repo: str, pr: int) -> None:
    """OS-285: an open PR whose head branch is a building spinoff row puts that row in phase pr_ci.

    pr-wait is what a builder runs right after `gh pr create` and after every later push, so this is the
    PR-opened hook for `spinoff.phase`. The row is found by its branch and repo among the building rows, never
    by ticket (a trial's leg b shares the ticket on another branch). A handed-off or landed row (the architect
    watching it) is left alone, and so is a sent-back row in `updating_pr`: the role map moves that one
    straight to handed-off once its fix is green. Any failure is one stderr line: the watch never stops for it.
    """
    try:
        head = json.loads(gh(["pr", "view", str(pr), "-R", repo, "--json", "state,headRefName"]))
    except (GhError, ValueError):
        return
    if not isinstance(head, dict) or head.get("state") != "OPEN" or not head.get("headRefName"):
        return
    branch = head["headRefName"]
    listed = ob(["spinoff", "list", "--status", "building", "--json"])
    if listed is None or listed.returncode != 0:
        return
    try:
        rows = json.loads(listed.stdout[listed.stdout.index("["):])
    except ValueError:
        return
    name = repo.rsplit("/", 1)[-1].lower()
    mine = [
        r for r in rows
        if isinstance(r, dict) and r.get("branch") == branch and r.get("status") == "building"
        and str(r.get("repo") or "").rstrip("/").rsplit("/", 1)[-1].lower() == name
    ]
    if not mine and any(isinstance(r, dict) and r.get("branch") == branch for r in rows):
        print(f"pr-wait: a building row is on {branch} but its repo is not {name}; not marking it pr_ci", file=sys.stderr, flush=True)
    if len(mine) != 1 or mine[0].get("phase") == "updating_pr":
        return  # not a spinoff's PR, ambiguous, or a send-back being fixed
    row = mine[0]
    done = ob(["spinoff", "phase", str(row["id"]), "pr_ci", "-q"])
    if done is None or done.returncode != 0:
        why = (done.stderr or done.stdout).strip().splitlines()[-1:] if done else ["ob did not run"]
        print(f"pr-wait: could not mark {row.get('ticket_ref')} pr_ci ({' '.join(why) or 'no output'}); watching anyway", file=sys.stderr, flush=True)
        return
    print(f"pr-wait: {row.get('ticket_ref')} is in phase pr_ci", file=sys.stderr, flush=True)


def lock(repo: str, pr: int):
    """Hold a per-PR lock for the life of the process. The OS drops it on exit."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    handle = open(STATE_DIR / f"{repo.replace('/', '__')}__{pr}.lock", "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.seek(0)
        pid = handle.read().strip() or "unknown"
        fail(f"pid {pid} already watches {repo}#{pr}. If no events reach you from it, run `kill {pid}` and start again.")
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


class Watcher:
    def __init__(self, repo: str, pr: int, until: str, interval: int, gate: str) -> None:
        self.repo, self.pr, self.until, self.interval, self.gate = repo, pr, until, interval, gate
        self.path = STATE_DIR / f"{repo.replace('/', '__')}__{pr}.json"
        self.state = self.load()
        self.baseline = self.state is None
        self.state = self.state or {"reported": []}
        self.reported: set[str] = set(self.state["reported"])
        self.me = gh(["api", "user", "--jq", ".login"]).strip()
        self.failed_polls = 0
        self.new_events = False

    def load(self) -> dict | None:
        try:
            return json.loads(self.path.read_text())
        except (OSError, ValueError):
            return None

    def save(self) -> None:
        self.state["reported"] = sorted(self.reported)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state))
        tmp.replace(self.path)

    def emit(self, key: str, line: str) -> bool:
        """Print an event once per PR, across restarts. Returns True when it is printed."""
        if key in self.reported:
            return False
        self.reported.add(key)
        if self.baseline:
            return False
        self.new_events = True
        print(f"#{self.pr} {line}", flush=True)
        return True

    def finish(self, code: int, line: str | None = None) -> None:
        if line:
            print(f"#{self.pr} {line}", flush=True)
        self.save()
        sys.exit(code)

    def checks(self) -> list[dict]:
        # gh pr checks exits 1 when a check failed and 8 while checks are pending: states, not errors.
        # A list, not a dict by name: two workflows can report checks of the same name, and every one counts.
        out = gh(["pr", "checks", str(self.pr), "-R", self.repo, "--json", "name,bucket,link,description"], ok=(0, 1, 8))
        return json.loads(out or "[]")

    def others_comments(self, author: str) -> list[tuple[str, str, str]]:
        """Comments, reviews and inline comments from people other than the author and the gh user."""
        base = f"repos/{self.repo}"
        jq = '.[] | [.id, .user.login, .html_url, (.body // "" | gsub("\\\\s+"; " ") | .[0:100])] | @tsv'
        found: list[tuple[str, str, str]] = []
        for path in (f"{base}/issues/{self.pr}/comments", f"{base}/pulls/{self.pr}/comments"):
            found += [tuple(r.split("\t", 3)) for r in gh(["api", path, "--paginate", "--jq", jq]).splitlines() if r]
        reviews = f"{base}/pulls/{self.pr}/reviews"
        found += [tuple(r.split("\t", 3)) for r in gh(["api", reviews, "--paginate", "--jq", jq]).splitlines() if r]
        return [f for f in found if f[1] not in (author, self.me) and not f[1].endswith("[bot]")]

    def poll(self) -> None:
        pr = json.loads(gh(["pr", "view", str(self.pr), "-R", self.repo,
                            "--json", "state,headRefOid,mergeStateStatus,author,url"]))
        url = pr["url"]
        if pr["state"] == "MERGED":
            self.finish(0, f"merged: {url}")
        if pr["state"] == "CLOSED":
            self.finish(1, f"closed without merging: {url}")

        head, short = pr["headRefOid"], pr["headRefOid"][:7]
        checks = self.checks()
        gates = [r for r in checks if r["name"] == self.gate]
        for gate in gates:
            if gate["bucket"] in FAILED:
                self.finish(1, f"gate failed on {short}: {gate['link']}")
        for row in checks:
            if row["bucket"] in FAILED:
                name = row["name"]
                what = "PixelSlash failed (a broken upload, not a review)" if is_pixelslash(name) else f"check {name} failed"
                self.finish(1, f"{what} on {short}: {row['link']}")
        # A pending PixelSlash status waits on a human review: not waited on, reported as owed (OB-2544).
        owed = [owed_line(r) for r in checks if is_pixelslash(r["name"]) and r["bucket"] not in PASSED]
        others = [r for r in checks if not is_pixelslash(r["name"]) and r["name"] != self.gate]
        # Green needs every check that is not PixelSlash passed, and at least one: the gate check, or, in a repo whose
        # CI has no check of that name, any other. No checks yet is pending, never green.
        gate_ok = all(g["bucket"] in PASSED for g in gates) if gates else bool(others)
        bucket = "pass" if gate_ok and all(r["bucket"] in PASSED for r in others) else "pending"

        merge = pr["mergeStateStatus"]
        if merge == "DIRTY":
            self.finish(1, "branch conflicts with its base: back to the builder to rebase")
        if merge == "BEHIND":
            line = "branch is BEHIND its base: back to the builder to update it"
            if self.until == "ready":
                self.finish(1, line)
            self.emit(f"behind:{head}", line)

        done = bucket == "pass" and (self.until == "green" or (self.until == "ready" and merge in MERGEABLE))
        if bucket == "pass" and not done:
            self.emit(f"pass:{head}", f"checks passed on {short}")
        for cid, login, link, body in self.others_comments(pr["author"]["login"]):
            self.emit(f"c:{cid}", f"comment from {login}: {snippet(body)} {link}")

        if done:
            for line in owed:
                print(f"#{self.pr} {line}", flush=True)
        if done and self.until == "green":
            self.finish(0, f"green on {short}")
        if done:
            self.finish(0, f"ready on {short}: gate green, {merge.lower()}")
        if self.until == "any-change" and self.new_events:
            self.finish(0)

    def run(self) -> None:
        while True:
            self.new_events = False
            try:
                self.poll()
                self.failed_polls = 0
            except GhError as error:
                self.failed_polls += 1
                print(f"pr-wait: poll failed ({self.failed_polls}/{MAX_FAILED_POLLS}): {error}", file=sys.stderr, flush=True)
                if self.failed_polls >= MAX_FAILED_POLLS:
                    self.finish(1, f"pr-wait stopped: GitHub unreachable for {self.failed_polls} polls: {error}")
            self.save()
            self.baseline = False
            time.sleep(self.interval)


def main() -> None:
    parser = argparse.ArgumentParser(prog="pr-wait", description="Watch a GitHub PR and print one line per real event.")
    parser.add_argument("pr", nargs="?", help="PR number or URL")
    parser.add_argument("--repo", help="owner/name (default: from the URL or the current checkout)")
    parser.add_argument("--until", choices=("green", "ready", "any-change"), default="ready")
    parser.add_argument("--gate", default="gate", help="name of the gate check on the PR head (default: gate)")
    parser.add_argument("--interval", type=int, default=20, help="seconds between polls (default 20, min 5)")
    args = parser.parse_args()
    repo, pr = parse_target(args.pr, args.repo)
    _lock = lock(repo, pr)
    mark_pr_ci(repo, pr)
    Watcher(repo, pr, args.until, max(args.interval, 5), args.gate).run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
